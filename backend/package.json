{
  "name": "quickprint-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:apply": "bun run src/scripts/apply-sql-migrations.ts",
    "db:ping": "bun run src/scripts/db-ping.ts",
    "db:check": "drizzle-kit check",
    "auth:migrate": "bunx auth@1.7.4 migrate --yes --config ./src/auth/index.ts",
    "retention:cleanup": "bun run src/scripts/retention-cleanup.ts",
    "kiosk:seed": "bun run db:apply && bun run src/scripts/seed-kiosk-1.ts",
    "kiosk:qr": "bun run src/scripts/generate-kiosk-qr.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "better-auth": "^1.7.4",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "razorpay": "^2.9.5",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.14",
    "qrcode": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "bun-types": "^1.2.4",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
