# PostgreSQL — local, AWS RDS, or any compatible host (see docs/rds-migration.md)
# Local:
# DATABASE_URL=postgresql://user:pass@localhost:5432/quickprint
# Production RDS (no sslmode in URL — TLS via RDS CA bundle on EC2):
DATABASE_URL=postgresql://USERNAME:PASSWORD@RDS_ENDPOINT:5432/quickprint
# RDS CA bundle path on EC2 (default: /etc/ssl/rds/global-bundle.pem)
# RDS_CA_CERT_PATH=/etc/ssl/rds/global-bundle.pem
# Optional pool tuning (see docs/database-performance.md)
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_MS=10000

BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=http://localhost:3000
# Comma-separated extra origins; Pi bootstrap (http://127.0.0.1:18765) is always allowed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# From Project Settings → Storage → S3 connection (not publishable/anon API keys)
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Exact bucket name from Storage (often lowercase, no spaces)
S3_BUCKET_NAME=quickprint

# Aliases (optional; used if S3_* unset)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MAX_UPLOAD_BYTES=52428800
# LibreOffice headless for DOC/DOCX → PDF conversion (backend EC2 only)
LIBREOFFICE_BIN=libreoffice
DOCUMENT_CONVERSION_TIMEOUT_MS=120000
DEFAULT_BW_SHEET_PAISE=200
DEFAULT_COLOR_SHEET_PAISE=300
PRESIGNED_URL_EXPIRES=3600

NODE_ENV=development
PORT=8000
